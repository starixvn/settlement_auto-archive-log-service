<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="appsettings.KLDR.json" />
    <Content Remove="appsettings.PROD.json" />
<Content Remove="appsettings.KLPROD.json" />
    <Content Remove="appsettings.UAT.json" />
  </ItemGroup>

  <ItemGroup>
<None Include="appsettings.KLPROD.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="appsettings.UAT.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.8" />
    <PackageReference Include="Fanex.Logging" Version="2.0.2" />
    <PackageReference Include="Fanex.Logging.Extensions" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="2.0.2.1" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.SiteDbConnectionManager.Client" Version="1.0.1" />
    <PackageReference Include="ONEbook.UM" Version="3.2.6" />
    <PackageReference Include="Quartz.AspNetCore" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoArchiveLog\AutoArchiveLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App_Data\SpName.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
